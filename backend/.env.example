# Puerto en el que escucha el servidor
PORT=3000

# Ruta del archivo de base de datos SQLite (relativa a la carpeta backend/)
DB_PATH=./data/portfolio.db

# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Live Server puede abrir con localhost o 127.0.0.1: son orígenes distintos para el navegador
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
